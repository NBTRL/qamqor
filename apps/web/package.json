{
  "name": "@club/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "gen:api": "pnpm gen:client",
    "gen:client": "openapi-typescript ../../packages/shared/openapi.json -o src/lib/api/schema.d.ts && node ../../scripts/gen-web-forms.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@club/shared": "workspace:*",
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "next": "15.5.28",
    "openapi-fetch": "^0.15.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
