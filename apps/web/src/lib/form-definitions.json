  },
  "RegionPatchDto": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 2, "maxLength": 160 },
      "slug": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  },
  "ReportWriteDto": {
    "type": "object",
    "properties": {
      "text": { "type": "string", "minLength": 20, "maxLength": 30000 },
      "hoursSpent": { "type": "number", "minimum": 0, "maximum": 1000 },
      "photos": {
        "maxItems": 30,
        "type": "array",
        "items": { "$ref": "#/components/schemas/PhotoReferenceDto" }
      }
    },
    "required": ["text", "hoursSpent"]
  },
  "SettingDto": {
    "type": "object",
    "properties": {
      "type": { "allOf": [{ "$ref": "#/components/schemas/NotificationType" }] },
      "telegram": { "type": "boolean" },
      "email": { "type": "boolean" }
    },
    "required": ["type", "telegram", "email"]
  },
  "SettingsWriteDto": {
    "type": "object",
    "properties": {
      "items": {
        "maxItems": 18,
        "type": "array",
        "items": { "$ref": "#/components/schemas/SettingDto" }
      }
    },
    "required": ["items"]
  },
  "StatOverrideDto": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "enum": [
          "places",
          "curators",
          "events12Months",
          "masterClasses12Months",
          "uniqueParticipants12Months",
          "beneficiaries",
          "trips"
        ]
      },
      "value": {
        "type": "integer",
        "nullable": true,
        "description": "null возвращает счетчик к расчету из БД.",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    "required": ["key", "value"]
  },
  "TripCreateDto": {
    "type": "object",
    "properties": {
      "placeId": { "type": "string", "format": "uuid" },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "description": { "type": "string", "maxLength": 20000 },
      "startsAt": { "type": "string", "format": "date-time" },
      "endsAt": { "type": "string", "format": "date-time" },
      "meetingPoint": { "type": "string", "minLength": 2, "maxLength": 500 },
      "capacity": { "type": "integer", "minimum": 1, "maximum": 1000 }
    },
    "required": [
      "placeId",
      "title",
      "description",
      "startsAt",
      "endsAt",
      "meetingPoint",
      "capacity"
    ]
  },
  "TripPatchDto": {
    "type": "object",
    "properties": {
      "placeId": { "type": "string", "format": "uuid" },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "description": { "type": "string", "maxLength": 20000 },
      "startsAt": { "type": "string", "format": "date-time" },
      "endsAt": { "type": "string", "format": "date-time" },
      "meetingPoint": { "type": "string", "minLength": 2, "maxLength": 500 },
      "capacity": { "type": "integer", "minimum": 1, "maximum": 1000 }
    }
  },
  "TripStatusDto": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["DRAFT", "OPEN", "CLOSED", "DONE", "REPORTED", "CANCELLED"]
      },
      "cancelReason": { "type": "string", "minLength": 3, "maxLength": 2000 }
    },
    "required": ["status"]
  },
  "UserCreateDto": {
    "type": "object",
    "properties": {
      "telegramId": { "type": "string", "pattern": "^[1-9]\\d{0,18}$" },
      "fullName": { "type": "string", "minLength": 2, "maxLength": 160 },
      "role": { "type": "string", "enum": ["CANDIDATE", "VOLUNTEER", "ADMIN"] },
      "email": { "type": "string", "nullable": true, "maxLength": 254, "format": "email" }
    },
    "required": ["telegramId", "fullName"]
  },
  "UserPatchDto": {
    "type": "object",
    "properties": {
      "fullName": { "type": "string", "minLength": 2, "maxLength": 160 },
      "nickname": { "type": "string", "nullable": true, "maxLength": 100 },
      "city": { "type": "string", "nullable": true, "maxLength": 160 },
      "role": { "type": "string", "enum": ["CANDIDATE", "VOLUNTEER", "ADMIN"] },
      "isBlocked": { "type": "boolean" },
      "email": { "type": "string", "nullable": true, "maxLength": 254, "format": "email" }
    }
  }
