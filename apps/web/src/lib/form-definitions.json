  "OpenDayWriteDto": {
    "type": "object",
    "properties": {
      "startsAt": { "type": "string", "format": "date-time" },
      "location": { "type": "string", "minLength": 2, "maxLength": 500 },
      "capacity": { "type": "integer", "minimum": 1, "maximum": 1000 },
