  "ProjectWriteDto": {
    "type": "object",
    "properties": {
      "slug": { "type": "string", "maxLength": 150, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
