{
  "AlbumWriteDto": {
    "type": "object",
    "properties": {
      "slug": { "type": "string", "maxLength": 150, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "description": { "type": "string", "maxLength": 10000 },
      "coverUrl": { "type": "string", "nullable": true, "maxLength": 2000, "format": "uri" },
      "publishedAt": { "type": "string", "nullable": true, "format": "date-time" }
    },
    "required": ["slug", "title"]
  },
  "ClubReportWriteDto": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
      "fileUrl": { "type": "string", "maxLength": 2000, "format": "uri" },
      "publishedAt": { "type": "string", "nullable": true, "format": "date-time" }
    },
    "required": ["title", "year", "fileUrl"]
  },
  "ContactPatchDto": {
    "type": "object",
    "properties": {
      "status": { "type": "string", "enum": ["NEW", "IN_PROGRESS", "DONE"] },
      "adminNote": { "type": "string", "nullable": true, "maxLength": 10000 }
    }
  },
  "CuratorAssignDto": {
    "type": "object",
    "properties": {
      "userId": { "type": "string", "format": "uuid" },
      "placeId": { "type": "string", "format": "uuid" }
    },
    "required": ["userId", "placeId"]
  },
  "DonationWriteDto": {
    "type": "object",
    "properties": {
      "amount": { "type": "string", "example": "1500.00", "maxLength": 15 },
      "currency": { "type": "string", "default": "RUB", "pattern": "^[A-Z]{3}$" },
      "donorName": { "type": "string", "nullable": true, "maxLength": 200 },
      "note": { "type": "string", "nullable": true, "maxLength": 5000 },
      "receivedAt": { "type": "string", "format": "date-time" }
    },
    "required": ["amount", "receivedAt"]
  },
  "EventPatchDto": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["CHARITY_ACTION", "CLUB_EVENT", "MASTER_CLASS", "SEMINAR", "LEISURE", "TRIP"]
      },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "description": { "type": "string", "maxLength": 20000 },
      "startsAt": { "type": "string", "format": "date-time" },
      "endsAt": { "type": "string", "format": "date-time" },
      "location": { "type": "string", "minLength": 2, "maxLength": 500 },
      "capacity": { "type": "integer", "nullable": true, "minimum": 1, "maximum": 1000 },
      "isPublic": { "type": "boolean", "default": true },
      "volunteersOnly": { "type": "boolean", "default": false }
    }
  },
  "EventWriteDto": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["CHARITY_ACTION", "CLUB_EVENT", "MASTER_CLASS", "SEMINAR", "LEISURE", "TRIP"]
      },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "description": { "type": "string", "maxLength": 20000 },
      "startsAt": { "type": "string", "format": "date-time" },
      "endsAt": { "type": "string", "format": "date-time" },
      "location": { "type": "string", "minLength": 2, "maxLength": 500 },
      "capacity": { "type": "integer", "nullable": true, "minimum": 1, "maximum": 1000 },
      "isPublic": { "type": "boolean", "default": true },
      "volunteersOnly": { "type": "boolean", "default": false }
    },
    "required": ["type", "title", "description", "startsAt", "endsAt", "location"]
  },
  "InterviewWriteDto": {
    "type": "object",
    "properties": {
      "slug": { "type": "string", "maxLength": 150, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "bodyHtml": { "type": "string", "maxLength": 100000 },
      "coverUrl": { "type": "string", "nullable": true, "maxLength": 2000, "format": "uri" },
      "publishedAt": { "type": "string", "nullable": true, "format": "date-time" }
    },
    "required": ["slug", "title", "bodyHtml"]
  },
  "MediaItemWriteDto": {
    "type": "object",
    "properties": {
      "albumId": { "type": "string", "format": "uuid" },
      "type": { "allOf": [{ "$ref": "#/components/schemas/MediaType" }] },
      "url": {
        "type": "string",
        "maxLength": 2000,
        "format": "uri",
        "description": "Ссылка на фото или видео выбранного типа. Управляемые изображения недопустимы для VIDEO. При смене типа нужна новая ссылка."
      },
      "caption": { "type": "string", "maxLength": 1000 },
      "isPublic": { "type": "boolean" },
      "sortOrder": { "type": "integer", "minimum": 0, "maximum": 100000 }
    },
    "required": ["albumId", "type", "url"]
  },
  "MediaType": { "type": "string", "enum": ["PHOTO", "VIDEO"] },
  "NeedWriteDto": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "description": { "type": "string", "maxLength": 2000 },
      "isActive": { "type": "boolean", "default": true }
    },
    "required": ["title", "description"]
  },
  "NeedsWriteDto": {
    "type": "object",
    "properties": {
      "items": {
        "maxItems": 100,
        "type": "array",
        "items": { "$ref": "#/components/schemas/NeedWriteDto" }
      }
    },
    "required": ["items"]
  },
  "NewsWriteDto": {
    "type": "object",
    "properties": {
      "slug": { "type": "string", "maxLength": 150, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 2, "maxLength": 200 },
      "bodyHtml": { "type": "string", "maxLength": 100000 },
      "excerpt": { "type": "string", "maxLength": 1000 },
      "coverUrl": { "type": "string", "nullable": true, "maxLength": 2000, "format": "uri" },
      "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
      "publishedAt": { "type": "string", "nullable": true, "format": "date-time" }
    },
    "required": ["slug", "title", "bodyHtml", "excerpt"]
  },
  "NotificationType": {
    "type": "string",
    "enum": [
      "ApplicationStatusChanged",
      "RegistrationConfirmed",
      "RegistrationRejected",
      "RegistrationWaitlisted",
      "RegistrationPromotedFromWaitlist",
      "RegistrationCancelled",
      "TripCancelled",
      "TripRescheduled",
      "TripReminder24h",
      "TripReminder3h",
      "NewRegistrationForCurator",
      "ReportRequestedFromCurator",
      "OpenDayReminder",
      "EventRegistered",
      "EventCancelled",
      "OpenDayRegistered",
      "EventRescheduled",
      "OpenDayRescheduled"
