      "import": "./dist/server.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "^5.9.3"
  }
}
