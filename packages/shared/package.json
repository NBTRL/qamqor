{
  "name": "@club/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "openapi.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
