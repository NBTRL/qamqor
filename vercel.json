{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "outputDirectory": ".vercel-api",
      "buildCommand": "pnpm --filter @club/shared build && pnpm run build && node ../../scripts/vercel-migrate.mjs && pnpm --filter @club/api deploy --prod --legacy --ignore-scripts .vercel-api && node ../../scripts/api-runtime-package.mjs --standalone"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @club/shared build && pnpm run build",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_INTERNAL_URL" }
      ]
    }
  },
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "instances": { "fra1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 50
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
