# Режим приложения: development локально, production на сервере, test для тестов.
NODE_ENV=development
# Локальный Postgres из docker-compose; production — строка подключения российского сервера БД.
DATABASE_URL=postgresql://club:club_local_only@localhost:55432/club?schema=public
# Локальный Redis из docker-compose; production — URL своего Redis.
REDIS_URL=redis://localhost:6379
# Сгенерируйте: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))".
# Первый локальный pnpm install генерирует случайное значение в игнорируемом .env.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Внешний origin web, без завершающего /; production использует HTTPS.
WEB_URL=http://localhost:3000
# Upstream Nest для Next rewrites и внешний HTTPS base URL при webhook; без /api/v1.
# Браузер использует /api/v1 своего origin.
PUBLIC_API_URL=http://localhost:4000
# Локальный MinIO из docker-compose; production — endpoint российского S3-хранилища.
S3_ENDPOINT=http://localhost:9000
# Имя бакета; локальный minio-init создаёт его автоматически.
S3_BUCKET=club-local
# Локальный access key; production — ключ отдельного сервисного пользователя S3.
S3_ACCESS_KEY=club_local_key
# Случайный ключ S3; первый локальный install создаёт его в .env.
S3_SECRET_KEY=replace-with-a-random-local-minio-secret
# Локальный Mailpit; production — SMTP-хост своего почтового сервиса.
SMTP_HOST=localhost
# SMTP Mailpit; production — порт, выданный почтовым сервисом.
SMTP_PORT=1025
# Для Mailpit пусто; production — имя пользователя SMTP.
SMTP_USER=
# Для Mailpit пусто; production — пароль приложения SMTP.
SMTP_PASS=
# Подтверждённый отправитель почтового сервиса; локально используется домен .test.
MAIL_FROM="Клуб волонтеров <no-reply@example.test>"
# Получить у @BotFather через /newbot. Пусто: API работает, реальный Telegram-вход недоступен.
TELEGRAM_BOT_TOKEN=
# Username созданного бота от @BotFather БЕЗ @. Обязателен при заданном bot token.
TELEGRAM_BOT_USERNAME=
# Отдельный случайный секрет Telegram webhook; не bot token. Нужен в режиме webhook.
TELEGRAM_WEBHOOK_SECRET=
# polling локально по умолчанию; webhook для сервера с публичным HTTPS.
TELEGRAM_MODE=polling
# true разрешён только локально. Сочетание с production останавливает запуск.
# Включает локальный POST /api/v1/dev/telegram/confirm без реального бота.
DEV_FAKE_TELEGRAM=false
# ID первого администратора из подтверждённого апдейта своего Telegram-бота; не username.
# Вместе с ADMIN_EMAIL используется командой pnpm db:seed. Телефон появится при входе через бота.
ADMIN_TELEGRAM_ID=
# Ваш e-mail первого администратора: seed сразу считает его подтвержденным. Проверьте адрес до запуска.
ADMIN_EMAIL=
